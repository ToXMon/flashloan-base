# ═══════════════════════════════════════════════════════════════
# Flash Loan Multi-Strategy — Base Network Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── RPC Endpoints ──────────────────────────────────────────────
# Alchemy (recommended — supports WebSocket + simulation)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# MEV Protection — Flashbots Protect RPC for Base
MEV_PROTECT_RPC=https://rpc.flashbots.net/fast

# ── Wallet ─────────────────────────────────────────────────────
# Use PRIVATE_KEY for deployment, MNEMONIC for HD wallet
PRIVATE_KEY=your_private_key_here
# MNEMONIC=your twelve word mnemonic phrase here

# ── API Keys ───────────────────────────────────────────────────
ALCHEMY_API_KEY=your_alchemy_api_key
BASESCAN_API_KEY=your_basescan_api_key

# ── Deployed Contracts ─────────────────────────────────────────
# Set after deployment
POSITION_CONTRACT=

# ── Token Addresses (Base) ─────────────────────────────────────
TOKEN_WETH=0x4200000000000000000000000000000000000006
TOKEN_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
TOKEN_DAI=0x50c5725949A6F0c72E6C4a641F24049A917DB0Cb
TOKEN_cbETH=0x2Ae3F1Ec7F1F5012CFEab0185bfc7aa3cf0DEc22
TOKEN_USDbC=0xd9aAEc86B65D86f6A7B5B1b0c42FFA531710b6CA

# ── Strategy Parameters ────────────────────────────────────────
HEALTH_FACTOR_THRESHOLD=1.1
DEFAULT_POOL_FEE=500
MAX_SLIPPAGE_BPS=50

# ── Execution ──────────────────────────────────────────────────
GAS_PRICE_MULTIPLIER=1.1
PRIORITY_FEE=0.001

# ── Scanner Settings ───────────────────────────────────────────
SCAN_INTERVAL_MS=15000
MIN_PROFIT_USD=0.10
